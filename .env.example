# GEOkit 环境变量样例
# 复制为 .env.local 后按需填写。全部为空也能正常运行 —— 只有「AI 可见性」需要 key。

# ── 中文 AI 平台 ────────────────────────────────────────────
DEEPSEEK_API_KEY=      # DeepSeek
DOUBAO_API_KEY=        # 豆包（火山方舟）
KIMI_API_KEY=          # Kimi（月之暗面）
QWEN_API_KEY=          # 通义千问（阿里云百炼）
WENXIN_API_KEY=        # 文心一言（百度千帆）
YUANBAO_API_KEY=       # 腾讯元宝

# ── 海外 AI 平台 ────────────────────────────────────────────
OPENAI_API_KEY=        # ChatGPT
ANTHROPIC_API_KEY=     # Claude
GEMINI_API_KEY=        # Gemini

# ── 可选：自建代理（SERP 采集被拦截时使用）───────────────────
# GEOKIT_PROXY_URL=http://127.0.0.1:7890

# ── 可选：Google Search Console（T5，三选一，都不配则该能力 unavailable）──
# 1) OAuth access token（约 1 小时有效，可由 Google OAuth Playground 获取）
# GOOGLE_OAUTH_ACCESS_TOKEN=ya29.xxxx
# 2) service account JSON 内联（自动用 RS256 JWT 换取并缓存令牌）
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"...","token_uri":"https://oauth2.googleapis.com/token"}
# 3) service account JSON 文件路径
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# 注意：service account 需在 Search Console 对应资源里被添加为用户。

# ── 可选：服务端口（默认 3210）──────────────────────────────
# PORT=3210
